[Unit]
Description=ScanVault API Server
Documentation=https://github.com/nikhil/scanvault
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=scanvault
Group=scanvault
WorkingDirectory=/opt/scanvault
ExecStart=/opt/scanvault/bin/scanvault-api
EnvironmentFile=/etc/scanvault/scanvault.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/scanvault

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scanvault-api

[Install]
WantedBy=multi-user.target
