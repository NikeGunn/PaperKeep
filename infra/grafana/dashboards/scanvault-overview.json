{
  "title": "ScanVault Overview",
  "uid": "scanvault-overview",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Request Count",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "ScanVault",
          "metricName": "request_count",
          "statistics": ["Sum"],
          "period": "60",
          "dimensions": {}
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Duration P99 (ms)",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "ScanVault",
          "metricName": "request_duration_ms",
          "statistics": ["p99"],
          "period": "60",
          "dimensions": {}
        }
      ]
    },
    {
      "id": 3,
      "title": "Lambda Errors",
      "type": "timeseries",
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "queryMode": "Metrics",
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "statistics": ["Sum"],
          "period": "60",
          "dimensions": { "FunctionName": "scanvault-*-go-backend" }
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" }
}
