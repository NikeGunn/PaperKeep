# Paperkeep release signing config
# Copy this file to `keystore.properties` (gitignored) and fill in your values.
# Generate the upload keystore once with:
#
#   keytool -genkey -v -keystore paperkeep-upload.jks \
#       -keyalg RSA -keysize 4096 -validity 10000 \
#       -alias paperkeep-upload
#
# Then place the .jks at the repo root (also gitignored) and reference it below.
# See android/store/signing-setup.md for the full walkthrough.

storeFile=paperkeep-upload.jks
storePassword=CHANGE_ME
keyAlias=paperkeep-upload
keyPassword=CHANGE_ME
