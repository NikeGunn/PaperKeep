<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Media read: pre-API-33 uses READ_EXTERNAL_STORAGE, API 33+ uses READ_MEDIA_IMAGES -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- WorkManager background sync -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- P4.4 — backup reminder notifications. Runtime-prompted on API 33+; AlarmManager
         uses inexact repeating so we deliberately do NOT request SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Write crash logs and backups to external storage on API < 29 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".PaperkeepApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Paperkeep">

        <!-- ── Main Activity ─────────────────────────────────────────────── -->
        <!-- exported=true: required because this activity holds the LAUNCHER
             intent-filter (system launchers must resolve it) and receives
             OPEN_CAMERA / IMPORT_IMAGES actions from our own widget + QS tile. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Paperkeep.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Widget / QS tile deep-link: open camera directly -->
            <intent-filter>
                <action android:name="app.paperkeep.action.OPEN_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Share extension: hand off imported images to scan flow -->
            <intent-filter>
                <action android:name="app.paperkeep.action.IMPORT_IMAGES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ── Share Import Activity (receives images from other apps) ───── -->
        <!-- exported=true: required to receive ACTION_SEND / ACTION_SEND_MULTIPLE
             from third-party apps (Gallery, Files, etc.). MIME filter allowlist
             below restricts to image/* and application/pdf only. -->
        <activity
            android:name=".share.ShareImportActivity"
            android:exported="true"
            android:label="@string/share_import_label"
            android:theme="@style/Theme.Paperkeep">
            <!-- Single image share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Multi-image share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- PDF import -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- ── Glance AppWidget: "Scan Now" ──────────────────────────────── -->
        <receiver
            android:name=".widget.ScanNowWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_scan_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scan_now_widget_info" />
        </receiver>

        <!-- ── Glance AppWidget: "Recent Scans" 4×1 ─────────────────────── -->
        <receiver
            android:name=".widget.RecentScansWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_recent_scans_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_scans_widget_info" />
        </receiver>

        <!-- ── Quick Settings Tile: "Scan document" ──────────────────────── -->
        <!-- exported=true: mandatory for QS tiles — system SystemUI binds the
             service. Protected by android.permission.BIND_QUICK_SETTINGS_TILE
             so only the system can bind. -->
        <service
            android:name=".qs.ScanDocumentTileService"
            android:exported="true"
            android:icon="@drawable/ic_scan_qs"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- ── P4.4: Backup reminder receiver ──────────────────────────── -->
        <!-- exported=false: only AlarmManager (inside our own UID) wakes this. -->
        <receiver
            android:name="app.paperkeep.core.backup.reminder.BackupReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.paperkeep.action.BACKUP_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- ── FileProvider for share/export payloads ──────────────────── -->
        <!-- Only exposes cacheDir/{shares,exports}/ to other apps via grantUriPermission.
             Plaintext PDFs and JPEGs live here for ~minutes during a share, never longer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager initialization (required on API < 24 for PeriodicWork) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge"
            xmlns:tools="http://schemas.android.com/tools">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
