# ScanVault API — systemd service unit
# Install: copy to /etc/systemd/system/scanvault.service
# Enable:  systemctl daemon-reload && systemctl enable scanvault && systemctl start scanvault
#
# The deploy script (scripts/release.sh) automatically restarts this service
# after updating the binary at /opt/scanvault/scanvault.

[Unit]
Description=ScanVault API Server
Documentation=https://github.com/nikhil/scanvault
After=network-online.target postgresql.service
Wants=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=scanvault
Group=scanvault
WorkingDirectory=/opt/scanvault

# Binary path — deploy script keeps previous version as scanvault.previous for rollback
ExecStart=/opt/scanvault/scanvault
ExecReload=/bin/kill -HUP $MAINPID

# Load environment variables from .env file
# This file is NOT in the repo — it holds secrets and is created during deploy
EnvironmentFile=/opt/scanvault/.env

# Restart policy — restart on crash, but not on clean exit (for intentional shutdown)
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/scanvault /var/log/scanvault
CapabilityBoundingSet=

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
TasksMax=256

# Kill signal — Go handles SIGTERM for graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
