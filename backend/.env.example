# =============================================================================
# ScanVault API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# ALL variables listed here are loaded by internal/config/config.go.
# Required vars will crash the server on startup if missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# PostgreSQL 16 connection string.
# Local dev: use the docker-compose Postgres instance.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://scanvault:scanvault@localhost:5433/scanvault?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication — PASETO v4 (Required)
# Generate with: openssl rand -base64 32
# This is the symmetric key used to sign and verify Paseto v4 session tokens.
# Rotate this key to invalidate ALL active sessions across all devices.
# Store in a secrets manager in production (1Password, AWS Secrets Manager, etc.)
# -----------------------------------------------------------------------------
PASETO_KEY=REPLACE_WITH_32_BYTES_BASE64_ENCODED_KEY

# -----------------------------------------------------------------------------
# Argon2id password hashing parameters (Required)
# These params must match what was used to hash existing passwords.
# Changing them only affects NEW passwords (old hashes store their own params).
#
# Recommended baseline (adjust based on your VPS hardware):
#   ARGON2_TIME=3       (iterations — higher = slower = stronger)
#   ARGON2_MEMORY=65536 (KB = 64 MB — memory per hash operation)
#   ARGON2_THREADS=4    (parallelism — match your CPU core count)
#
# Test on your VPS: time the hash function and target 200-500ms per hash.
# See: https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html
# -----------------------------------------------------------------------------
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_THREADS=4

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Required)
# R2 is S3-compatible with zero egress fees — ideal for a document scanner.
#
# R2_ENDPOINT: Your account endpoint, format:
#   https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY / R2_SECRET_KEY: R2 API token credentials (not your CF account key)
#   Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_BUCKET: The bucket name you created for ScanVault.
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=scanvault-dev

# -----------------------------------------------------------------------------
# Transactional Email — Postmark (Required)
# Used for: email verification, password reset, account deletion confirmation.
# Create at: https://postmarkapp.com → API Tokens → Server API Token
# Alternative: Resend (https://resend.com) — update internal/email/ accordingly.
# -----------------------------------------------------------------------------
POSTMARK_TOKEN=REPLACE_WITH_POSTMARK_SERVER_API_TOKEN

# -----------------------------------------------------------------------------
# Error Reporting — Sentry (Optional)
# Leave empty to disable Sentry. The server starts fine without it.
# NOTE: Sentry is configured to strip all user data before sending — only
# stack traces and error types are reported. Never user content or IDs.
# Create DSN at: https://sentry.io → Project Settings → Client Keys
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Security — IP Hashing Key (Required)
# HMAC-SHA256 key used to pseudonymize IP addresses in logs.
# IPs are never stored raw — they're HMAC'd so logs are useful for abuse
# detection but cannot be used to identify individuals.
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
IP_HASH_KEY=REPLACE_WITH_32_BYTES_BASE64_ENCODED_HMAC_KEY

# -----------------------------------------------------------------------------
# Server (Optional — has defaults)
# SERVER_PORT: Port the Go HTTP server listens on (default: 8080)
#   In production, Caddy listens on 443 and reverse-proxies to this port.
# ENVIRONMENT: Controls logging verbosity and safety checks.
#   Must be one of: dev | staging | prod
#   dev     — verbose logging, relaxed CORS, no rate limits enforced strictly
#   staging — production-like, but uses staging email templates and S3 bucket
#   prod    — full rate limits, strict CORS, minimal log verbosity
# -----------------------------------------------------------------------------
SERVER_PORT=8080
ENVIRONMENT=dev

# -----------------------------------------------------------------------------
# VPS SSH Access (used by scripts/rollback.sh and CI deploy scripts)
# Not used by the API binary itself — only referenced by shell scripts.
# -----------------------------------------------------------------------------
VPS_HOST=your.vps.hostname.or.ip
VPS_USER=scanvault
VPS_SSH_KEY=~/.ssh/id_ed25519
