# Intelligence Layer Configuration
# Copy to .env and fill in values

# Server
INTEL_HOST=0.0.0.0
INTEL_PORT=8100
INTEL_WORKERS=1
INTEL_DEBUG=true

# Redis
INTEL_REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (S3-compatible)
INTEL_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
INTEL_R2_ACCESS_KEY=
INTEL_R2_SECRET_KEY=
INTEL_R2_BUCKET=scanvault-processing

# Models
INTEL_MODEL_CACHE_DIR=./models

# Feature flags
INTEL_ENABLE_OCR=true
INTEL_ENABLE_VISION=true
INTEL_ENABLE_AI=false
INTEL_ENABLE_GPU=false

# Processing limits
INTEL_MAX_IMAGE_SIZE_MB=50
INTEL_MAX_PROCESSING_TIME_SECONDS=120
INTEL_PROCESSING_TTL_HOURS=1
