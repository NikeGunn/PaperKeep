# =============================================================================
# ScanVault — EditorConfig
# https://editorconfig.org
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin and Java — 4-space indent
[*.{kt,kts,java}]
indent_style = space
indent_size = 4

# Go — tabs (gofmt standard)
[*.go]
indent_style = tab
indent_size = 4

# Python — 4-space indent (PEP 8)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Markdown — preserve trailing whitespace (two spaces = line break)
[*.md]
trim_trailing_whitespace = false

# Makefile — must use tabs
[Makefile]
indent_style = tab

# Gradle
[*.gradle]
indent_style = space
indent_size = 4

# Protobuf
[*.proto]
indent_style = space
indent_size = 2

# TOML
[*.toml]
indent_style = space
indent_size = 4
